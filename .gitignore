# =====================================
# Java / Spring Boot / Maven .gitignore
# =====================================

# Build output
target/
build/
out/

# IDEs and editors
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
.DS_Store

# Logs and temporary files
*.log
*.tmp
*.bak
*.pid

# OS-generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment / config secrets
application-local.yml
application-dev.yml
.env
*.env
*.pem
*.key
*.crt

# Maven
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties
.settings/
dependency-reduced-pom.xml

# Node (if frontend lives inside repo)
node_modules/
dist/
package-lock.json

# JetBrains IDEs cache
out/
.idea_modules/
*.class

# Test reports
test-output/
surefire-reports/

# Temporary DBs or generated content
*.db
*.sqlite
data/
